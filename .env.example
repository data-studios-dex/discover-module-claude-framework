# ---------------------------------------------------------------- DATABASE
# SQLite (default demo):
DB_URL=sqlite:///sample/sample.db
# PostgreSQL example:  DB_URL=postgresql://user:password@host:5432/mydb
# Oracle example:      DB_URL=oracle+oracledb://user:password@host:1521/?service_name=ORCL
# (non-sqlite engines need: pip install sqlalchemy + the driver)
DB_SCHEMA=main

# --------------------------------------------------------------- ANTHROPIC
# Leave the placeholder to run in OFFLINE deterministic mode (no key needed).
# Paste a real key to switch every agent to Claude-powered generation/fixing.
ANTHROPIC_API_KEY=sk-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ------------------------------------------------------------ ORCHESTRATION
MAX_PARALLEL_TABLES=4        # S6 fan-out semaphore
MAX_FIX_ATTEMPTS=3           # S1 loop retry cap per SQL
MAX_UNRESOLVED_DQ=0          # G5: allowed unresolved DQ checks per table

# ------------------------------------------------------------------- DEMO
# Inject one unfixable SQL (missing table) into DEMO_FAILURE_TABLE so the
# report shows a CLOSED gate with its reason. Set false for clean runs.
DEMO_INJECT_FAILURE=true
DEMO_FAILURE_TABLE=products
